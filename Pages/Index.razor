@page "/"
@using Tracking.Web.Services
@using Tracking.Web.Models
@inject ITrackingService TrackingService
@inject ILogger<Index> Logger

<PageTitle>Rastreamento de Pedidos</PageTitle>

<!-- Seção de Busca -->
<section class="search-section">
    <div class="section-intro">
        <h3><i class="fas fa-map-marker-alt"></i> Rastreamento de Entrega</h3>
        <p>Insira o CPF ou e-mail para acompanhar cada etapa do seu pedido</p>
    </div>

    <div class="search-card">
        <div class="card-header">
            <h4>Consultar Status</h4>
            <div class="card-badge">
                <i class="fas fa-star"></i>
                <span>Exclusivo</span>
            </div>
        </div>

        <EditForm Model="@searchModel" OnValidSubmit="@HandleSearch">
            <DataAnnotationsValidator />
            
            <div class="form-group-elegant">
                <label for="trackingCode">
                    <i class="fas fa-hashtag"></i>
                    CPF ou E-mail
                </label>
                <div class="input-with-button">
                    <InputText 
                        id="trackingCode"
                        @bind-Value="searchModel.Code"
                        placeholder="Digite seu CPF (somente números) ou e-mail"
                        disabled="@isLoading"
                        class="@(validationError != null ? "input-error" : "")" />

                    <button type="submit" class="search-button mobile-tall" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>Buscando...</span>
                        }
                        else
                        {
                            <i class="fas fa-search"></i>
                            <span>Rastrear</span>
                        }
                    </button>
                </div>

                @if (validationError != null)
                {
                    <p class="input-error-message">
                        <i class="fas fa-exclamation-triangle"></i>
                        @validationError
                    </p>
                }
                else
                {
                    <p class="input-hint">
                        <i class="fas fa-info-circle"></i>
                        Digite seu CPF (somente números) ou e-mail cadastrado.
                    </p>
                }
            </div>
        </EditForm>
    </div>
</section>

<!-- Seção de Resultados -->
@if (trackingData != null && trackingData.Events.Any())
{
    <section class="results-section">
        <div class="order-info-card">
            <div class="info-header">
                <div>
                    <h4>Detalhes da Entrega</h4>
                    <div class="order-status">
                        <span class="status-badge @GetStatusClass()">
                            <i class="fas @GetStatusIcon()"></i>
                            @GetCurrentStatus()
                        </span>
                    </div>
                </div>
                <div class="order-meta">
                    <div class="meta-item">
                        <span class="meta-label">Pedido:</span>
                        <span class="meta-value">@trackingData.OrderNumber</span>
                    </div>
                    <div class="meta-item highlight">
                        <span class="meta-label">Previsão:</span>
                        <span class="meta-value">@trackingData.PredictionDate</span>
                    </div>
                </div>
            </div>

            <div class="info-grid">
                <div class="grid-item">
                    <span class="grid-label">Data do Pedido</span>
                    <span class="grid-value">@trackingData.OrderDate</span>
                </div>
                @if (!string.IsNullOrEmpty(trackingData.IdErp))
                {
                    <div class="grid-item">
                        <span class="grid-label">ID ERP</span>
                        <span class="grid-value">@trackingData.IdErp</span>
                    </div>
                }
            </div>
        </div>

        <div class="timeline-modern">
            <div class="timeline-header">
                <h4><i class="fas fa-history"></i> Histórico da Entrega</h4>
                <p>Cronologia completa dos eventos (@trackingData.Events.Count evento(s))</p>
            </div>

            <div class="timeline-content">
                @foreach (var evt in trackingData.Events)
                {
                    <div class="timeline-item @GetEventClass(evt)">
                        <div class="timeline-marker">
                            <i class="fas @GetEventIcon(evt)"></i>
                        </div>
                        <div class="timeline-content-box">
                            <div class="timeline-date">@evt.Date</div>
                            <div class="timeline-title">@evt.Status</div>
                            <div class="timeline-description">@evt.Description</div>
                            @if (!string.IsNullOrEmpty(evt.Complement))
                            {
                                <div class="timeline-complement">
                                    <i class="fas fa-info-circle"></i>
                                    @evt.Complement
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else if (showNotFound)
{
    <!-- Mensagem de Não Encontrado -->
    <section class="empty-state">
        <div class="empty-content">
            <div class="empty-icon error">
                <i class="fas fa-exclamation-circle"></i>
            </div>
            <h4>Pedido Não Encontrado</h4>
            <p>@(string.IsNullOrEmpty(errorMessage) ? "Não localizamos nenhum pedido com este CPF ou e-mail." : errorMessage)</p>
            <div class="empty-tips">
                <div class="tip">
                    <i class="fas fa-user-check"></i>
                    <span>Verifique se o CPF ou e-mail estão corretos</span>
                </div>
                <div class="tip">
                    <i class="fas fa-clock"></i>
                    <span>Pedidos recentes podem levar alguns minutos para aparecer</span>
                </div>
            </div>
        </div>
    </section>
}
else if (showError)
{
    <!-- Mensagem de Erro -->
    <section class="empty-state">
        <div class="empty-content">
            <div class="empty-icon error">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h4>Erro ao Consultar</h4>
            <p>@errorMessage</p>
            <button class="btn-primary" @onclick="ClearError">
                <i class="fas fa-redo"></i>
                Tentar Novamente
            </button>
        </div>
    </section>
}
else if (!hasSearched)
{
    <!-- Estado Inicial -->
    <section class="empty-state">
        <div class="empty-content">
            <div class="empty-icon">
                <i class="fas fa-box-open"></i>
            </div>
            <h4>Aguardando Consulta</h4>
            <p>Insira o CPF ou e-mail para visualizar o status do seu pedido.</p>
            <div class="empty-tips">
                <div class="tip">
                    <i class="fas fa-shield-alt"></i>
                    <span>Seus dados são protegidos e não são armazenados</span>
                </div>
                <div class="tip">
                    <i class="fas fa-clock"></i>
                    <span>Consulta em tempo real</span>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private SearchModel searchModel = new();
    private FrontendTrackingResponse? trackingData;

    private bool isLoading = false;
    private bool hasSearched = false;
    private bool showNotFound = false;
    private bool showError = false;
    private string? validationError;
    private string? errorMessage;

    public class SearchModel
    {
        public string Code { get; set; } = string.Empty;
    }

    private async Task HandleSearch()
    {
        validationError = null;
        showNotFound = false;
        showError = false;
        errorMessage = null;
        trackingData = null;

        if (string.IsNullOrWhiteSpace(searchModel.Code))
        {
            validationError = "Campo obrigatório";
            return;
        }

        var cleanCode = new string(searchModel.Code.Where(c => char.IsLetterOrDigit(c) || c == '@' || c == '.').ToArray());

        if (cleanCode.Length < 3)
        {
            validationError = "CPF ou e-mail inválido";
            return;
        }

        isLoading = true;
        hasSearched = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Iniciando busca para código: {Code}", MaskCode(cleanCode));

            var apiResponse = await TrackingService.GetTrackingAsync(cleanCode);

            if (apiResponse == null)
            {
                showNotFound = true;
                errorMessage = "Não foi possível consultar o rastreamento. Tente novamente.";
                Logger.LogInformation("Nenhum resultado (null) para código: {Code}", MaskCode(cleanCode));
            }
            else if (apiResponse.Code == 404 || apiResponse.Message.Contains("não localizado", StringComparison.OrdinalIgnoreCase))
            {
                showNotFound = true;
                errorMessage = "CPF ou e-mail não encontrado. Verifique os dados e tente novamente.";
                Logger.LogInformation("API retornou Code={Code}, Message={Message} para código: {Code}", 
                    apiResponse.Code, apiResponse.Message, MaskCode(cleanCode));
            }
            else if (apiResponse.Message != "OK")
            {
                showNotFound = true;
                errorMessage = apiResponse.Message;
                Logger.LogInformation("API retornou: {Message} para código: {Code}", 
                    apiResponse.Message, MaskCode(cleanCode));
            }
            else if (!apiResponse.ShippingEvents.Any(e => 
                e.DtShipping.HasValue && 
                !string.IsNullOrEmpty(e.DsCode) && 
                e.InternalCode.HasValue && 
                e.InternalCode.Value > 0))
            {
                showNotFound = true;
                errorMessage = "Nenhum evento de rastreamento disponível para este pedido.";
                Logger.LogInformation("Eventos inválidos para código: {Code}", MaskCode(cleanCode));
            }
            else
            {
                trackingData = new FrontendTrackingResponse
                {
                    OrderNumber = apiResponse.Info?.Number,
                    OrderDate = apiResponse.Info?.Date,
                    PredictionDate = apiResponse.Info?.Prediction,
                    IdErp = apiResponse.Info?.IdErp,
                    Message = apiResponse.Message,
                    Events = apiResponse.ShippingEvents
                        .Where(e => 
                            e.DtShipping.HasValue && 
                            !string.IsNullOrEmpty(e.DsCode) && 
                            e.InternalCode.HasValue && 
                            e.InternalCode.Value > 0)
                        .OrderByDescending(e => e.DtShipping!.Value)
                        .Select(e => new FrontendEvent
                        {
                            Date = e.DtShipping!.Value.ToString("dd/MM/yyyy HH:mm"),
                            Status = e.DsCode,
                            Description = e.Message,
                            Complement = e.Complement,
                            InternalCode = e.InternalCode
                        })
                        .ToList()
                };

                Logger.LogInformation("Rastreamento encontrado: {OrderNumber} com {Count} eventos",
                    trackingData.OrderNumber, trackingData.Events.Count);
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Erro inesperado ao buscar rastreamento. Tente novamente mais tarde.";
            Logger.LogError(ex, "Erro inesperado ao buscar rastreamento para {Code}", MaskCode(cleanCode));
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetCurrentStatus()
    {
        if (trackingData?.Events == null || !trackingData.Events.Any())
            return "Aguardando";

        return trackingData.Events.First().Status;
    }

    private string GetStatusClass()
    {
        var lastEvent = trackingData?.Events?.FirstOrDefault();
        if (lastEvent == null) return "pending";

        return lastEvent.InternalCode switch
        {
            90 => "delivered",
            75 => "in-transit",
            _ => "pending"
        };
    }

    private string GetStatusIcon()
    {
        var lastEvent = trackingData?.Events?.FirstOrDefault();
        if (lastEvent == null) return "fa-clock";

        return lastEvent.InternalCode switch
        {
            90 => "fa-check-circle",
            75 => "fa-truck",
            _ => "fa-box"
        };
    }

    private string GetEventClass(FrontendEvent evt)
    {
        return evt.InternalCode switch
        {
            90 => "completed",
            75 => "active",
            _ => ""
        };
    }

    private string GetEventIcon(FrontendEvent evt)
    {
        return evt.InternalCode switch
        {
            90 => "fa-check-circle",
            75 => "fa-truck",
            _ => "fa-circle"
        };
    }

    private void ClearError()
    {
        showError = false;
        errorMessage = null;
    }

    private string MaskCode(string code)
    {
        if (string.IsNullOrEmpty(code)) return "****";

        if (code.Contains('@'))
        {
            var parts = code.Split('@');
            if (parts.Length == 2 && parts[0].Length > 2)
            {
                return $"{parts[0][0]}***{parts[0][^1]}@{parts[1]}";
            }
        }

        if (code.Length >= 4)
        {
            return new string('*', code.Length - 2) + code[^2..];
        }

        return "****";
    }
}