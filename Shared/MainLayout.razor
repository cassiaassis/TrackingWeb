@inherits LayoutComponentBase

<!-- Header (a partir do seu index.html) -->
<header class="header-constellation">
    <div class="container header-container">
        <div class="header-content">
            <div class="logo-constellation">
                <div class="logo-mark">
                    <img src="imagens/logoContatellation.png" alt="Constellation Logo" class="logo-image" />
                </div>
            </div>

            <div class="brand-statements-container">
                <span class="brand-statement">Somos a Constellation.</span>
                <span class="brand-statement">We are the Constellation.</span>
            </div>
        </div>
    </div>
</header>

<!-- Banner (mantive aqui como no seu HTML original) -->
<section class="gift-banner">
    <div class="container">
        <div class="banner-wrapper">
            <div class="banner-icon">
                <i class="fas fa-gift"></i>
            </div>
            <div class="banner-content">
                <h2>Seu Presente Especial</h2>
                <p>Reconhecendo e valorizando seus colaboradores</p>
            </div>
        </div>
    </div>
</section>

<!-- Main: aqui o @Body será substituído pelo conteúdo das páginas (Index.razor etc.) -->
<main class="container main-content">
    @Body
</main>

<!-- Footer (a partir do seu index.html) -->
<footer class="footer-minimal">
    <div class="container">
        <div class="footer-content">
            <div class="footer-left">
                <div class="contact-info">
                    <p><i class="fas fa-envelope"></i> suporte@2log.com.br</p>
                    <!-- <p><i class="fas fa-phone"></i> Suporte: (11) 3333-4444</p> -->
                    <p class="contact-hours">Segunda a Sexta, das 8h00 às 18h00</p>
                </div>
            </div>
            <div class="footer-right">
                <!-- Espaço reservado -->
            </div>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
            <div class="footer-credits-centered">
                <div class="footer-signature">
                    <a href="https://2log.com.br" target="_blank" rel="noopener noreferrer" class="signature-integrated">
                        <div class="sig-line-top">
                            <span class="sig-label">Powered by</span>
                        </div>
                        <div class="sig-line-bottom">
                            <img src="imagens/2log-logo.png" alt="2log Smart Solutions" class="sig-logo-image" />
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>

<!-- Modal de Ajuda (mantido no layout para estar disponível em qualquer página) -->
<div class="modal-overlay" id="helpModal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="helpModalTitle">
        <div class="modal-header">
            <h4 id="helpModalTitle"><i class="fas fa-headset"></i> Suporte ao Funcionário</h4>
            <button class="modal-close" id="closeModal" aria-label="Fechar">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="support-options">
                <div class="support-option">
                    <i class="fas fa-building"></i>
                    <h5>Departamento de RH</h5>
                    <p>Para questões sobre elegibilidade ou não recebimento do código</p>
                    <a href="mailto:rh@constellation.com" class="support-link">
                        <i class="fas fa-envelope"></i>
                        Enviar E-mail
                    </a>
                </div>
                <div class="support-option">
                    <i class="fas fa-shipping-fast"></i>
                    <h5>Suporte de Entrega</h5>
                    <p>Para problemas com a entrega ou status incorreto</p>
                    <a href="tel:+551133334444" class="support-link">
                        <i class="fas fa-phone"></i>
                        Ligar Agora
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay (mantido globalmente) -->
<div class="loading-overlay" id="loadingOverlay" aria-hidden="true">
    <div class="loading-content">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p>Buscando informações da entrega...</p>
    </div>
</div>